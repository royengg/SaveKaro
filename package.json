{
  "name": "savekaro",
  "private": true,
  "workspaces": ["backend", "frontend", "mobile", "packages/*"],
  "scripts": {
    "dev:web": "bun run --cwd frontend dev",
    "dev:api": "bun run --cwd backend dev",
    "dev:mobile": "bun run --cwd mobile start",
    "build:web": "bun run --cwd frontend build",
    "build:api": "bun run --cwd backend build",
    "check:api": "bun run --cwd backend typecheck",
    "check:mobile": "bun run --cwd mobile typecheck"
  }
}
